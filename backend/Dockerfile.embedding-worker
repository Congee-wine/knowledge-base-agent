FROM python:3.12-slim

WORKDIR /app

# Do not inherit a host or base-image package mirror. A mirror that advertises
# one wheel hash and returns another makes pip reject otherwise valid installs.
ENV PIP_INDEX_URL=https://pypi.org/simple \
    PIP_EXTRA_INDEX_URL= \
    PIP_REQUIRE_HASHES=0

COPY requirements.embedding-worker.txt ./
RUN pip install --no-cache-dir --default-timeout=120 --retries 5 \
    --index-url https://pypi.org/simple \
    -r requirements.embedding-worker.txt

COPY . .

CMD ["python", "-c", "from workers.runner import run_embedding_worker; run_embedding_worker()"]
