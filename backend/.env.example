# PostgreSQL + pgvector. Do not commit the real .env file.
DATABASE_URL=postgresql://ai_app:replace-with-your-db-password@127.0.0.1:5432/ai_platform
# Reuse PostgreSQL connections for API requests. Keep these conservative for local development.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
AUTH_SECRET_KEY=replace-with-a-long-random-secret

# Background jobs. Redis is required when document processing is enabled.
REDIS_URL=redis://127.0.0.1:6379/0

# Private S3-compatible object storage. Local development uses MinIO.
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-object-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-object-storage-secret-key
OBJECT_STORAGE_BUCKET=ai-platform-private
OBJECT_STORAGE_SECURE=false

# Added in phase 4 when real RAG chat is enabled. Do not put real keys in Git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Added in phase 3 when the local embedding Worker is enabled.
BGE_MODEL_NAME=BAAI/bge-m3
# Local reranker used after candidate recall. The embedding Worker downloads and caches it on first use.
BGE_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Worker-local model cache. In Docker this should be backed by a persistent volume.
BGE_MODEL_CACHE_DIR=/models/bge
# Upload and Worker limits. The API/processing implementation will consume these in later phase 3 steps.
DOCUMENT_MAX_FILE_SIZE_BYTES=20971520
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=900
DOCUMENT_EMBEDDING_BATCH_SIZE=16
# CPU 本地开发默认仅重排 8 个融合候选；需要压测后再提高。
RERANK_CANDIDATE_LIMIT=8
RETRIEVAL_QUERY_TIMEOUT_SECONDS=120
STREAM_GENERATION_TIMEOUT_SECONDS=300
STREAM_EVENT_RETENTION_SECONDS=900
STREAM_ANSWER_FLUSH_CHARACTERS=16
STREAM_ANSWER_FLUSH_INTERVAL_MILLISECONDS=60
STREAM_SEQUENCE_CHECKPOINT_SECONDS=1
STREAM_INTERRUPT_CHECK_INTERVAL_MILLISECONDS=250
